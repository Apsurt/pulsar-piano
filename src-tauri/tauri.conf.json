{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pulsar",
  "version": "../package.json",
  "identifier": "com.apsurt.pulsar",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pulsar",
        "width": 1200,
        "height": 760,
        "minWidth": 800,
        "minHeight": 500,
        "theme": "Dark",
        "backgroundColor": "#0A0A0F"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb"],
    "createUpdaterArtifacts": true,
    "category": "Music",
    "shortDescription": "Piano",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "depends": ["libasound2"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwRDA0NEJCNTFCMUU3REQKUldUZDU3RlJ1MFRRd05PVlNRbTgxUDNkQ3NhTWNSSURxVlVtK2RYOGZ0eEtLemF1WXg0UERIbU8K",
      "endpoints": [
        "https://github.com/Apsurt/pulsar-piano/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
